{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otis",
  "version": "0.1.47",
  "identifier": "ai.triangllabs.otis",
  "build": {
    "beforeDevCommand": "bun run build:sidecar && bun run dev:tauri:renderer",
    "beforeBuildCommand": "bun run build:sidecar && bun run build:tauri:renderer",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Otis",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#1A1A1A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage"],
    "externalBin": ["binaries/otis-runtime"],
    "icon": ["../resources/icon.png", "../resources/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
