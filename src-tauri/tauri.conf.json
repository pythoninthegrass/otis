{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otis",
  "version": "0.1.47",
  "identifier": "ai.triangllabs.otis",
  "build": {
    "beforeDevCommand": "bun run build:sidecar && bun run dev:tauri:renderer",
    "beforeBuildCommand": "bun run build:sidecar && bun run build:tauri:renderer",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Otis",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#1A1A1A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage"],
    "externalBin": ["binaries/otis-runtime"],
    "icon": ["../resources/icon.png", "../resources/icon.icns"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OTJDODI3RDgyQzU3OQpSV1I1eFlKOWdpeFpDNmp1SVl2T1RVNXhuN29wNGFpUGllZUhJdFVodU11c3ZwTkV5TURhMFphTQo=",
      "endpoints": ["https://github.com/triangllabs/otis/releases/latest/download/latest.json"]
    }
  }
}
