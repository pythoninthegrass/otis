{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/desktop/sidecar/**/*.ts",
    "src/desktop/sidecar/**/*.d.ts",
    "tests/desktop/sidecar/**/*.ts",
    "src/text-modules.d.ts"
  ]
}
